      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Stations ouvertes proposant le carburant sélectionné",
          "description": "Cette carte affiche les stations qui proposent le carburant sélectionné et qui sont ouvertes le jour choisi. Les stations en rupture sont exclues afin de montrer uniquement les options réellement exploitables pour l’entreprise.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfo97m7z87m68f"
                      },
                      "spec": {
                        "dataset": "carburants",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    s.latitude,\n    s.longitude,\n    s.ville,\n    s.adresse,\n    c.nom_carburant,\n    rp.prix,\n    h.jour,\n    h.heure_ouverture,\n    h.heure_fermeture\nFROM STATION s\nJOIN RELEVES_PRIX rp ON s.id_station = rp.id_station\nJOIN CARBURANT c ON rp.id_carburant = c.id_carburant\nJOIN HORAIRE h ON s.id_station = h.id_station\nWHERE c.nom_carburant = '$carburant'\n  AND h.jour = '$jour'\n  AND s.latitude IS NOT NULL\n  AND s.longitude IS NOT NULL\n  AND NOT EXISTS (\n      SELECT 1\n      FROM RUPTURE r\n      WHERE r.id_station = s.id_station\n        AND r.id_carburant = c.id_carburant\n  )\nORDER BY rp.prix ASC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
