      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Répartition des ruptures par carburant",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfo97m7z87m68f"
                      },
                      "spec": {
                        "dataset": "carburants",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    c.nom_carburant AS carburant,\n    COUNT(*) AS nombre_ruptures\nFROM RUPTURE r\nJOIN CARBURANT c ON c.id_carburant = r.id_carburant\nGROUP BY c.nom_carburant\nORDER BY nombre_ruptures DESC;",
