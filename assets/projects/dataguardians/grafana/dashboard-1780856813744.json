      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Stations accessibles selon le jour choisi",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
