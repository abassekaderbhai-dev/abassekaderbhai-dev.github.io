      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Indicateurs clés",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfo97m7z87m68f"
                      },
                      "spec": {
                        "dataset": "carburants",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    (\n        SELECT COUNT(DISTINCT rp.id_station)\n        FROM RELEVES_PRIX rp\n        JOIN CARBURANT c ON rp.id_carburant = c.id_carburant\n        WHERE c.nom_carburant = '$carburant'\n    ) AS \"Nombre de stations\",\n\n    (\n        SELECT ROUND(AVG(rp.prix), 3)\n        FROM RELEVES_PRIX rp\n        JOIN CARBURANT c ON rp.id_carburant = c.id_carburant\n        WHERE c.nom_carburant = '$carburant'\n    ) AS \"Prix moyen\",\n\n    (\n        SELECT MIN(rp.prix)\n        FROM RELEVES_PRIX rp\n        JOIN CARBURANT c ON rp.id_carburant = c.id_carburant\n        WHERE c.nom_carburant = '$carburant'\n    ) AS \"Prix le plus bas\",\n\n    (\n        SELECT MAX(rp.prix)\n        FROM RELEVES_PRIX rp\n        JOIN CARBURANT c ON rp.id_carburant = c.id_carburant\n        WHERE c.nom_carburant = '$carburant'\n    ) AS \"Prix le plus haut\",\n\n    (\n        SELECT COUNT(*)\n        FROM RUPTURE r\n        JOIN CARBURANT c ON r.id_carburant = c.id_carburant\n        WHERE c.nom_carburant = '$carburant'\n    ) AS \"Nombre de ruptures\";",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
