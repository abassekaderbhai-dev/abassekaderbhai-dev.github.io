                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfo97m7z87m68f"
                      },
                      "spec": {
                        "dataset": "carburants",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT DISTINCT\n    s.id_station,\n    s.adresse,\n    s.ville,\n    h.jour,\n    h.heure_ouverture,\n    h.heure_fermeture,\n    c.nom_carburant,\n    rp.prix\nFROM HORAIRE h\nJOIN STATION s ON s.id_station = h.id_station\nJOIN RELEVES_PRIX rp ON rp.id_station = s.id_station\nJOIN CARBURANT c ON c.id_carburant = rp.id_carburant\nWHERE h.jour = '$jour'\n  AND c.nom_carburant = '$carburant'\nORDER BY rp.prix ASC\nLIMIT 100;",
                        "sql": {
