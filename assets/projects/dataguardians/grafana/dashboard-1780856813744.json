                        "rawQuery": true,
                        "rawSql": "SELECT\n    s.id_station,\n    s.adresse,\n    s.ville,\n    COUNT(*) AS nombre_ruptures\nFROM RUPTURE r\nJOIN STATION s ON s.id_station = r.id_station\nGROUP BY s.id_station, s.adresse, s.ville\nORDER BY nombre_ruptures DESC\nLIMIT 15;",
