      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Stations les plus avantageuses",
          "description": "Ce graphique affiche les stations qui proposent un prix inférieur au prix moyen du carburant sélectionné. Il permet de voir rapidement quelles stations sont les plus avantageuses et combien l’entreprise peut économiser par litre en choisissant ces stations plutôt qu’une station au prix moyen.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfo97m7z87m68f"
                      },
                      "spec": {
                        "dataset": "carburants",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH moyenne_carburant AS (\n    SELECT\n        c.nom_carburant,\n        AVG(rp.prix) AS prix_moyen\n    FROM RELEVES_PRIX rp\n    JOIN CARBURANT c ON rp.id_carburant = c.id_carburant\n    WHERE c.nom_carburant = '$carburant'\n    GROUP BY c.nom_carburant\n)\n\nSELECT\n    s.ville || ' - ' || s.adresse AS station,\n    ROUND((mc.prix_moyen - rp.prix), 3) AS economie_par_litre\nFROM RELEVES_PRIX rp\nJOIN STATION s ON rp.id_station = s.id_station\nJOIN CARBURANT c ON rp.id_carburant = c.id_carburant\nJOIN moyenne_carburant mc ON c.nom_carburant = mc.nom_carburant\nWHERE c.nom_carburant = '$carburant'\n  AND rp.prix < mc.prix_moyen\nORDER BY economie_par_litre DESC\nLIMIT 15;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
